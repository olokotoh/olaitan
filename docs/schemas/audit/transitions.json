{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/olokotoh/olaitan/docs/schemas/audit/transitions.json",
  "title": "AUDIT.transitions (audit.transitions.v1)",
  "description": "Story 2.8 append-only SIEM projection of schema.StateTransition. AUTHORITATIVE validation source for AUDIT.transitions; transitions.yaml is the human-readable mirror. Field-name normalisation is literal on the wire (before_state=FromState, after_state=ToState, triggering_threat_score=Confidence) so a SIEM ingest needs no rename map. decided_at (FSM decision time) and published_at (audit-emission time) are deliberately distinct (BI-1.3).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "before_state",
    "after_state",
    "triggering_threat_score",
    "package_id",
    "workload_id",
    "trigger_type",
    "reason",
    "decided_at",
    "published_at"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "audit.transitions.v1"},
    "before_state": {"type": "string", "enum": ["CLEAN", "SUSPICIOUS", "RESTRICTED", "QUARANTINED", "PRESERVED_KILLED"]},
    "after_state": {"type": "string", "enum": ["CLEAN", "SUSPICIOUS", "RESTRICTED", "QUARANTINED", "PRESERVED_KILLED"]},
    "triggering_threat_score": {"type": "number"},
    "package_id": {"type": "string"},
    "workload_id": {"type": "string"},
    "trigger_type": {"type": "string", "enum": ["automated", "override"]},
    "reason": {"type": "string", "enum": ["escalation_threshold_crossed", "dwell_guard_elapsed", "de_escalation_cooldown_expired", "no_transition", "operator_override", "kill_condition_met"]},
    "operator_id": {"type": "string"},
    "decided_at": {"type": "string", "format": "date-time"},
    "published_at": {"type": "string", "format": "date-time"}
  }
}
